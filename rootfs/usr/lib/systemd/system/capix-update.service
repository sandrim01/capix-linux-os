[Unit]
Description=Capix: atualização automática em segundo plano (aplicada no próximo boot)
Wants=network-online.target
After=network-online.target
ConditionACPower=true

[Service]
# Não roda enquanto alguém estiver no modo gamer (Capix Central)
ExecCondition=/bin/sh -c 'for f in /var/home/*/.config/capix/gamer-on /home/*/.config/capix/gamer-on; do [ -e "$$f" ] && exit 1; done; exit 0'
Type=oneshot
Nice=19
IOSchedulingClass=idle
# Baixa e prepara a nova imagem do sistema; NÃO reinicia (como no FydeOS)
ExecStart=/usr/bin/bootc upgrade --quiet
# Atualiza os apps Flatpak
ExecStart=-/usr/bin/flatpak update --system --noninteractive --assumeyes
