<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>UnbugSTI</vendor>
  <action id="org.capix.admin">
    <description>Administrar o Capix (atualizações, apps, quiosque)</description>
    <description xml:lang="pt_BR">Administrar o Capix (atualizações, apps, quiosque)</description>
    <message>A Capix Central precisa de permissão de administrador para fazer isso</message>
    <message xml:lang="pt_BR">A Capix Central precisa de permissão de administrador para fazer isso</message>
    <icon_name>capix-start</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/capix/capix-admin</annotate>
  </action>
</policyconfig>
