# Capix site — servidor estático para o Railway.
# O Railway injeta a porta em $PORT e termina o HTTPS na borda,
# então o Caddy só serve HTTP na porta indicada (sem auto-TLS).
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode gzip zstd
	file_server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Cache-Control "public, max-age=3600"
	}
}
